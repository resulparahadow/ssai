# =============================================================================
# SmartStars CRM — production Docker environment.
#   cp .env.docker.example .env   (compose reads .env for BOTH container env_file
#   and build-arg interpolation), then fill in every <...> placeholder.
# =============================================================================

APP_NAME="SmartStars"
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show   (base64:...)
APP_DEBUG=false
APP_URL=https://your-domain.com

# Host port the nginx `web` service binds (put a TLS reverse proxy in front).
WEB_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Containers log to the Docker stream (docker compose logs), not files.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- Database (the `mysql` service) -----------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ssai_crm
DB_USERNAME=ssai
DB_PASSWORD=422f9cdad99fa46d7dd95291ee1dd786
DB_ROOT_PASSWORD=248395f5bf335cf7723be41c15b9f7e0

# ---- Redis (cache / sessions / queue / reverb scaling) ----------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# ---- Broadcasting / Reverb websockets ---------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=115806
REVERB_APP_KEY=8412e303bccf4de40f27d3dd05a17d48
REVERB_APP_SECRET=9af7c7b8d8eb2bb0e923ea19e778582c

# Server-side: how the Laravel app reaches the Reverb container (internal net).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true

# Client-side (baked into the JS bundle at BUILD time — set to the PUBLIC URL).
# Changing these requires rebuilding the app + web images. nginx proxies the
# /app websocket path to the reverb container, so use your public host + 443.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ---- Mail (configure a real transport for production) -----------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@smartstars.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- SmartStars AI providers (server-held; never exposed to the browser) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-nemo
ONLYFANS_API_KEY=
ONLYFANS_BASE_URL=https://app.onlyfansapi.com/api
ONLYFANS_WEBHOOK_SECRET=

# ---- Node engine sidecar (the `engine` service) -----------------------------
ENGINE_URL=http://engine:8787
ENGINE_TIMEOUT=60

# ---- First-run seed (ProductionSeeder: admin + Test model) ------------------
# Consumed only when you seed (see docker/README.md). ADMIN_PASSWORD must be set
# to create the first admin; leave it blank to skip user creation.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
# Optional: link the seeded "Test" model to an OnlyFans account (acct_XXXX).
TEST_MODEL_OF_ACCOUNT_ID=

ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@smartstars.com
ADMIN_PASSWORD=password